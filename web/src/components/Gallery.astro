---
const shots = [
  { img: '/assets/peter/peter-band-out.jpg', alt: 'Peter lifting the IronPal headband out of his gym bag — the reveal.' },
  { img: '/assets/peter/peter-curl.jpg',     alt: 'Peter wearing the IronPal headband, doing dumbbell biceps curls, facing the camera.' },
  { img: '/assets/peter/peter-squat.jpg',    alt: "Peter wearing the IronPal headband, squatting under a barbell, seen from the side — the teal ring visible." },
];
---
<section class="gallery reveal" aria-label="Peter, IronPal's founder, training with the band">
  {shots.map((s) => (<figure><img src={s.img} alt={s.alt} loading="lazy" /></figure>))}
</section>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
  .gallery figure { position: relative; overflow: hidden; aspect-ratio: 1/1; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.85); transition: transform .8s var(--ease), filter .5s; }
  .gallery figure:hover img { transform: scale(1.05); filter: saturate(1); }
  @media (max-width: 540px) { .gallery { grid-template-columns: 1fr 1fr; } }
</style>
