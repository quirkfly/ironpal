
.env
.venv/
__pycache__/
scripts/video-gen/.venv/
scripts/video-gen/output/
scripts/video-gen/logs/

# S3 editorial intermediates (regeneratable from runway-output + Resolve workflow; too large for GitHub)
post/proxies/*.mov
post/proxies/*.bak
.sudo_passwd

# secrets
credentials/

# IronPal KB: large pulled workout clips (keep frames, not source video)
input/kb/clips/

# IronPal KB: scratch analysis frames (contact sheets/montages/zooms) — regenerable from clips
out/

# X session HARs contain auth cookies/tokens — never commit
input/x/
*.har

# Stray working screenshots at repo root (scratch, regenerable)
/*.png

# Social-feed generated images (regenerable from prompts)
/feed/

# IronPal KB: pulled gallery images + scratch analysis frames (regenerable / large)
/input/kb/images/
/input/kb/frames/

# Brand / social post image assets (regenerable, large)
/post/assets/

# Ontology source caches (regenerable: scripts/kb/build_ontology.py --fetch).
# The wger dump is CC-BY-SA 4.0 -- committing it would pull copyleft data into
# the repo. Only the derived ontology.json (public-domain sources) is tracked.
/input/kb/ontology-sources/

# Sealed ground-truth logs — must not reach the analyst before predictions are written
# (blind protocol, see docs/ironpal-essential-exercise-video-capture-plan.md §7b)
input/kb/groundtruth-sealed/

# Game assets: raw Leonardo output (paid, regenerable from docs/ironpal-game-asset-prompts.md)
/input/game-assets/

# the live subscriber list only ever exists on the server
web/server/emails.db*

# Kickstarter film: media inputs, renders and pipeline caches (large binaries; tracked text and the
